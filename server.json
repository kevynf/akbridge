{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kevynf/akbridge",
  "title": "AKBridge",
  "description": "Search and call AKShare financial data interfaces through three routed MCP tools",
  "repository": {
    "url": "https://github.com/kevynf/akbridge",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "akbridge",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--mode",
          "value": "router"
        }
      ]
    }
  ]
}
